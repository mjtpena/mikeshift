<?xml version="1.0" encoding="utf-8"?>
<!--
  Two Application entries in one package:
    "App"  - the tray app (Shiftvert.exe, GUI subsystem): Open at Login startup task.
    "Cli"  - the console CLI (cli\shiftvert.exe), hidden from the Start menu, owner of the `shiftvert.exe` execution alias.
  The CLI is a separate, self-contained copy in the cli\ folder (see "Packaging (W4b)" in Shiftvert.App.csproj); it cannot sit next to
  Shiftvert.exe because Windows file names are case-insensitive (Shiftvert.exe / shiftvert.exe, Shiftvert.dll / shiftvert.dll).
  Publisher must match the signing certificate: packaging\make-dev-cert.ps1 creates "CN=Shiftvert Dev".
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 rescap">

  <Identity
    Name="Shiftvert"
    Publisher="CN=Shiftvert Dev"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>Shiftvert</DisplayName>
    <PublisherDisplayName>Shiftvert contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Shiftvert"
        Description="Shift-drag a file to convert it."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- Open at Login (StartupService, TaskId must match). Disabled until the user turns it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="Shiftvert.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ShiftvertStartup" Enabled="false" DisplayName="Shiftvert" />
        </desktop:Extension>
      </Extensions>
    </Application>

    <Application Id="Cli" Executable="cli\shiftvert.exe" EntryPoint="Windows.FullTrustApplication" desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Shiftvert command line"
        Description="Convert files from a terminal: shiftvert --list / --run."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <!-- `shiftvert.exe` on PATH (%LOCALAPPDATA%\Microsoft\WindowsApps), console subsystem so stdout/stderr/exit code reach the terminal. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="cli\shiftvert.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="shiftvert.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
