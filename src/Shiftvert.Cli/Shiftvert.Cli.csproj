<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>shiftvert</AssemblyName>
    <RootNamespace>Shiftvert.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shiftvert.Core\Shiftvert.Core.csproj" />
  </ItemGroup>

  <!-- Packaging (W4b) -->
  <PropertyGroup>
    <!-- Shiftvert.App publishes this project self-contained for the MSIX (package\cli\shiftvert.exe); plain builds stay framework-dependent. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
