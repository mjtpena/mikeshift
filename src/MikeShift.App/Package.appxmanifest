<?xml version="1.0" encoding="utf-8"?>
<!--
  One Application entry, "App": the tray app (MikeShift.exe, GUI subsystem), with the Open at Login startup task, and the
  `mikeshift.exe` execution alias, which starts the console CLI (MikeShift.Cli.exe). The CLI is not an Application of its own: the
  Microsoft Store rejects an Application with AppListEntry="none" (a "headless app") without a waiver, and a visible one would put a
  console tile in the Start menu.
  The CLI sits next to MikeShift.exe and runs on the same bundled .NET runtime (see "Packaging" in MikeShift.App.csproj). It is called
  MikeShift.Cli.exe, not mikeshift.exe, because Windows file names are case-insensitive; the alias name is independent of the file name.
  Identity and PublisherDisplayName are the Microsoft Store values from Partner Center (Product identity). For a sideloaded build,
  Publisher must also be the signing certificate subject: packaging\make-dev-cert.ps1 creates a self-signed certificate with it.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap uap5 desktop desktop4 desktop5 com rescap systemai">

  <Identity
    Name="2259MichaelJohnTimpocPea.MikeShift"
    Publisher="CN=C81A4E31-21AC-4917-B3E7-F1C28300F48A"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>MikeShift</DisplayName>
    <PublisherDisplayName>mjtpena</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <!-- SupportsMultipleInstances is required by the console alias below; the tray app stays single-instance itself (Program.cs). -->
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="MikeShift"
        Description="Convert files from File Explorer: right-click, or Shift-drag. Nothing leaves your PC."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Logos are generated from assets\brand\mikeshift.svg by scripts\make-icons.ps1 (scale-100..400, targetsize-16..256 and unplated variants). -->
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Open at Login (StartupService, TaskId must match). Disabled until the user turns it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="MikeShift.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MikeShiftStartup" Enabled="false" DisplayName="MikeShift" />
        </desktop:Extension>

        <!-- `mikeshift.exe` on PATH (%LOCALAPPDATA%\Microsoft\WindowsApps). The alias runs MikeShift.Cli.exe, not the app's MikeShift.exe,
             with the console subsystem so stdout/stderr/exit code reach the terminal. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="MikeShift.Cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="mikeshift.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>

        <!-- Explorer right-click entry "Convert with MikeShift" (src\MikeShift.App\Shell, docs/developer/architecture.md "Explorer right-click").
             The COM server is OUT of process: Windows starts `MikeShift.exe -Embedding` (Program.Main hands it to ShellExtensionServer, which
             never starts WinUI) the first time the menu is built, so no MikeShift or .NET code is loaded into explorer.exe.
             One class: the IExplorerCommand for the Windows 11 modern menu (and the one menu of Windows 10). Keep the CLSID in step with
             ShellNames. Whether "Show more options" also lists it depends on the Windows build; see docs/limitations.md. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="MikeShift.exe" Arguments="-Embedding" DisplayName="MikeShift Explorer integration">
              <com:Class Id="02dcb673-3099-4372-86cb-c7f4fad75db8" DisplayName="MikeShift Convert command" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ConvertWithMikeShift" Clsid="02dcb673-3099-4372-86cb-c7f4fad75db8" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ConvertFolderWithMikeShift" Clsid="02dcb673-3099-4372-86cb-c7f4fad75db8" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Lets the Windows AI image scaler (Upscale 2x on Copilot+ PCs) run for this app. Not a network capability: Windows installs the model
         itself; MikeShift opens no connection (docs/privacy.md). Needs MaxVersionTested 10.0.26226.0 or later. -->
    <systemai:Capability Name="systemAIModels" />
  </Capabilities>
</Package>
