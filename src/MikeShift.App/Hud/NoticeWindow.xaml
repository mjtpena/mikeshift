<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MikeShift.App.Hud.NoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fb="using:MikeShift.Core.Feedback"
    Title="MikeShift">

    <!-- A ContentDialog-style layout in a real window: icon + heading + body + list on top, a button bar underneath. -->
    <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,20,24,22" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="SeverityIcon" FontFamily="Segoe Fluent Icons" FontSize="28" VerticalAlignment="Top"
                      Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />

            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <ScrollViewer x:Name="ItemsScroll" MaxHeight="260" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemList" AutomationProperties.Name="Files that could not be converted">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fb:DialogItem">
                                <StackPanel Margin="0,0,0,10" Spacing="1" AutomationProperties.Name="{x:Bind Line}">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="FooterText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel x:Name="ButtonBar" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
