<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MikeShift.App.Editors.MergeOrderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MikeShift.App.Editors"
    Title="Merge order">

    <Grid x:Name="Root" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                <ListView x:Name="FileList" SelectionMode="Single" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                          AutomationProperties.Name="Files to merge, in order"
                          SelectionChanged="OnSelectionChanged" DragItemsCompleted="OnDragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:OrderRow">
                            <Grid ColumnSpacing="12" Padding="0,6" AutomationProperties.Name="{x:Bind Description, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number, Mode=OneWay}" VerticalAlignment="Center" HorizontalTextAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Folder}" Visibility="{x:Bind FolderVisibility}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="UpButton" MinWidth="132" HorizontalContentAlignment="Left" Click="OnUpClicked"
                        ToolTipService.ToolTip="Move the selected file earlier (Alt+Up)" AutomationProperties.Name="Move up (Alt+Up)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Move up" />
                    </StackPanel>
                </Button>
                <Button x:Name="DownButton" MinWidth="132" HorizontalContentAlignment="Left" Click="OnDownClicked"
                        ToolTipService.ToolTip="Move the selected file later (Alt+Down)" AutomationProperties.Name="Move down (Alt+Down)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Move down" />
                    </StackPanel>
                </Button>
                <Button x:Name="SortButton" MinWidth="132" HorizontalContentAlignment="Left" Click="OnSortClicked"
                        ToolTipService.ToolTip="Put the files in order of their names, reading numbers as numbers (2 before 10)"
                        AutomationProperties.Name="Sort by name">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8CB;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Sort by name" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" Click="OnCancelClicked"
                    AutomationProperties.Name="Cancel (Escape)" />
            <Button x:Name="MergeButton" Content="Merge" MinWidth="88" Style="{StaticResource AccentButtonStyle}"
                    Click="OnMergeClicked" AutomationProperties.Name="Merge (Enter)" />
        </StackPanel>
    </Grid>
</Window>
