<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The tray flyout's header (UX review T-02): product icon, name, and the one-line hint. Not interactive. It is a
         MenuFlyoutSeparator with a custom template, because H.NotifyIcon's second-window host forces real items to 32 px. -->
    <Style x:Key="TrayHeaderStyle" TargetType="MenuFlyoutSeparator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutSeparator">
                    <Grid Padding="12,10,16,8" ColumnSpacing="12" MinWidth="248" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Tag.IconUri, RelativeSource={RelativeSource TemplatedParent}}" Width="32" Height="32"
                               VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Tag.Title, RelativeSource={RelativeSource TemplatedParent}}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Tag.Hint, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
