<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MikeShift.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MikeShift Settings">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="18" MaxWidth="560" HorizontalAlignment="Stretch">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="OpenAtLoginSwitch" Header="Open at login"
                              OnContent="On" OffContent="Off" Toggled="OnOpenAtLoginToggled" />
                <TextBlock x:Name="OpenAtLoginNote" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ToggleSwitch x:Name="ChimeSwitch" Header="Play a chime when a conversion succeeds"
                          OnContent="On" OffContent="Off" Toggled="OnChimeToggled" />

            <ToggleSwitch x:Name="ToastSwitch" Header="Show a small toast with the result"
                          OnContent="On" OffContent="Off" Toggled="OnToastToggled" />

            <StackPanel Spacing="6">
                <RadioButtons x:Name="ToolsKeyChoice" Header="Switch the wheel to tools with"
                              SelectionChanged="OnToolsKeyChanged">
                    <RadioButton Content="Ctrl (default)" Tag="Ctrl" />
                    <RadioButton Content="Mouse wheel only" Tag="MouseWheelOnly" />
                    <RadioButton Content="Alt" Tag="Alt" />
                </RadioButtons>
                <TextBlock x:Name="AltNote" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Alt may switch the input language (Left Alt + Shift is a Windows hotkey) and can interrupt Explorer. Ctrl is recommended." />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="A mouse-wheel tick toggles the page in every mode. Shift always switches back to formats." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Formats on this PC" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel x:Name="CodecList" Spacing="4" />
                <TextBlock x:Name="CodecHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Window>
