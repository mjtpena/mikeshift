<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MikeShift.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MikeShift.App.Settings"
    Title="Settings">

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" IsTabStop="False">
        <StackPanel Padding="24,8,24,28" Spacing="4" MaxWidth="760" HorizontalAlignment="Stretch">

            <!-- ============================== General ============================== -->
            <TextBlock Text="General" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="1,4,0,6" />

            <local:SettingsCard Header="Open at login" Description="Start MikeShift when you sign in to Windows." HeaderIcon="&#xE7E8;">
                <ToggleSwitch x:Name="OpenAtLoginSwitch" OnContent="On" OffContent="Off" Toggled="OnOpenAtLoginToggled"
                              AutomationProperties.Name="Open at login" MinWidth="0" />
            </local:SettingsCard>
            <InfoBar x:Name="OpenAtLoginNote" Severity="Warning" IsOpen="False" IsClosable="False" />

            <local:SettingsCard Header="Play a sound when a file is converted" Description="A short chime when a conversion finishes." HeaderIcon="&#xE767;">
                <ToggleSwitch x:Name="ChimeSwitch" OnContent="On" OffContent="Off" Toggled="OnChimeToggled"
                              AutomationProperties.Name="Play a sound when a file is converted" MinWidth="0" />
            </local:SettingsCard>

            <local:SettingsCard Header="Show a message when a file is converted" Description="A small message near the bottom of the screen." HeaderIcon="&#xE91C;">
                <ToggleSwitch x:Name="ToastSwitch" OnContent="On" OffContent="Off" Toggled="OnToastToggled"
                              AutomationProperties.Name="Show a message when a file is converted" MinWidth="0" />
            </local:SettingsCard>

            <local:SettingsCard x:Name="RevealCard" Header="Show the file in its folder after converting"
                                Description="Converted files are saved next to the originals. This also opens File Explorer on the result."
                                HeaderIcon="&#xE838;">
                <ToggleSwitch x:Name="RevealSwitch" OnContent="On" OffContent="Off" Toggled="OnRevealToggled"
                              AutomationProperties.Name="Show the file in its folder after converting" MinWidth="0" />
            </local:SettingsCard>

            <local:SettingsCard x:Name="WordCard" Header="Use Microsoft Word for Word documents"
                                Description="Better-looking PDFs from Word files and support for old .doc files. Word may connect to Microsoft."
                                HeaderIcon="&#xE8A5;">
                <ToggleSwitch x:Name="WordSwitch" OnContent="On" OffContent="Off" Toggled="OnWordToggled"
                              AutomationProperties.Name="Use Microsoft Word for Word documents" MinWidth="0" />
            </local:SettingsCard>

            <!-- ============================== Conversions ============================== -->
            <TextBlock Text="Conversions" Style="{StaticResource SettingsGroupHeaderStyle}" />

            <local:SettingsCard x:Name="QualityCard" Header="Picture quality"
                                Description="How much detail JPG, WebP and HEIC pictures keep. Higher is sharper and makes bigger files. PNG is always lossless."
                                HeaderIcon="&#xEB9F;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="10"
                            TickFrequency="10" TickPlacement="None" SnapsTo="StepValues" Width="170" VerticalAlignment="Center"
                            ValueChanged="OnQualityChanged" AutomationProperties.Name="Picture quality" />
                    <TextBlock x:Name="QualityValue" MinWidth="64" VerticalAlignment="Center" TextAlignment="Right" />
                </StackPanel>
            </local:SettingsCard>

            <local:SettingsCard x:Name="CompressCard" Header="Compress strength" HeaderIcon="&#xE7B8;">
                <ComboBox x:Name="CompressChoice" MinWidth="150" SelectionChanged="OnCompressChanged" AutomationProperties.Name="Compress strength">
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Medium" Tag="Medium" />
                    <ComboBoxItem Content="Strong" Tag="Strong" />
                </ComboBox>
            </local:SettingsCard>

            <local:SettingsCard x:Name="ResizeCard" Header="Resize" HeaderIcon="&#xE73F;">
                <ComboBox x:Name="ResizeChoice" MinWidth="150" SelectionChanged="OnResizeChanged" AutomationProperties.Name="Resize to">
                    <ComboBoxItem Content="25%" Tag="25" />
                    <ComboBoxItem Content="50%" Tag="50" />
                    <ComboBoxItem Content="75%" Tag="75" />
                </ComboBox>
            </local:SettingsCard>

            <local:SettingsCard x:Name="GifCard" Header="GIF length"
                                Description="The longest a GIF made from a video can run. GIFs play 10 pictures a second and are at most 480 pixels wide, so long ones get big."
                                HeaderIcon="&#xE916;">
                <ComboBox x:Name="GifChoice" MinWidth="150" SelectionChanged="OnGifSecondsChanged" AutomationProperties.Name="GIF length">
                    <ComboBoxItem Content="5 seconds" Tag="5" />
                    <ComboBoxItem Content="10 seconds" Tag="10" />
                    <ComboBoxItem Content="15 seconds" Tag="15" />
                    <ComboBoxItem Content="30 seconds" Tag="30" />
                </ComboBox>
            </local:SettingsCard>

            <Expander x:Name="OutputExpander" Style="{StaticResource SettingsExpanderStyle}" AutomationProperties.Name="Where converted files go">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Where converted files go" />
                            <TextBlock x:Name="OutputSummary" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10" Padding="0,4,0,4">
                    <RadioButtons x:Name="OutputChoice" SelectionChanged="OnOutputChoiceChanged" AutomationProperties.Name="Where converted files go">
                        <RadioButton Content="Next to the original" Tag="Beside" />
                        <RadioButton Content="A folder I choose" Tag="Folder" />
                    </RadioButtons>
                    <StackPanel x:Name="OutputFolderRow" Orientation="Horizontal" Spacing="12" Margin="28,0,0,0">
                        <Button Content="Choose folder…" Click="OnChooseOutputFolderClicked" AutomationProperties.Name="Choose the folder for converted files" />
                        <TextBlock x:Name="OutputFolderPath" VerticalAlignment="Center" MaxWidth="440" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <InfoBar x:Name="OutputNote" Severity="Warning" IsOpen="False" IsClosable="False" />
                    <TextBlock x:Name="OutputHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <!-- ============================== Ways to open the wheel ============================== -->
            <TextBlock Text="Open the wheel" Style="{StaticResource SettingsGroupHeaderStyle}" />

            <Expander x:Name="ArmKeyExpander" Style="{StaticResource SettingsExpanderStyle}" AutomationProperties.Name="Open the wheel while dragging with">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Open the wheel while dragging with" />
                            <TextBlock x:Name="ArmKeySummary" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10" Padding="0,4,0,4">
                    <RadioButtons x:Name="ArmKeyChoice" SelectionChanged="OnArmKeyChanged" AutomationProperties.Name="Open the wheel while dragging with">
                        <RadioButton Content="Hold Shift" Tag="Shift" />
                        <RadioButton Content="Hold Ctrl" Tag="Ctrl" />
                    </RadioButtons>
                    <TextBlock x:Name="ArmKeyNote" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <local:SettingsCard x:Name="HotkeyCard" Header="Convert the files selected in File Explorer" HeaderIcon="&#xE765;">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="HotkeyButton" MinWidth="170" Click="OnHotkeyButtonClicked" PreviewKeyDown="OnHotkeyPreviewKeyDown"
                            LostFocus="OnHotkeyLostFocus" AutomationProperties.Name="Keyboard shortcut for the files selected in File Explorer. Select to change." />
                    <Button x:Name="HotkeyOffButton" Click="OnHotkeyOffClicked" />
                </StackPanel>
            </local:SettingsCard>
            <InfoBar x:Name="HotkeyNote" Severity="Warning" IsOpen="False" IsClosable="False" />

            <!-- ============================== Wheel ============================== -->
            <TextBlock Text="Wheel" Style="{StaticResource SettingsGroupHeaderStyle}" />

            <Expander x:Name="ToolsExpander" Style="{StaticResource SettingsExpanderStyle}" AutomationProperties.Name="Switch to tools with">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Switch to tools with" />
                            <TextBlock x:Name="ToolsKeySummary" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10" Padding="0,4,0,4">
                    <RadioButtons x:Name="ToolsKeyChoice" SelectionChanged="OnToolsKeyChanged" AutomationProperties.Name="Switch to tools with">
                        <RadioButton x:Name="ToolsOtherKeyChoice" Content="Ctrl (recommended)" Tag="Ctrl" />
                        <RadioButton Content="Mouse wheel only" Tag="MouseWheelOnly" />
                        <RadioButton Content="Alt" Tag="Alt" />
                    </RadioButtons>
                    <InfoBar x:Name="AltNote" Severity="Warning" IsOpen="False" IsClosable="False" />
                    <TextBlock x:Name="ToolsKeyNote" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <!-- ============================== Format support ============================== -->
            <TextBlock Text="Format support" Style="{StaticResource SettingsGroupHeaderStyle}" />

            <InfoBar x:Name="RestartNote" Severity="Informational" IsOpen="False" IsClosable="False"
                     Title="Something changed" Message="Windows now supports a different set of formats. Restart MikeShift to use them.">
                <InfoBar.ActionButton>
                    <Button Content="Restart MikeShift" Click="OnRestartClicked" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Expander x:Name="CodecExpander" Style="{StaticResource SettingsExpanderStyle}" AutomationProperties.Name="Format support">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Format support" />
                            <TextBlock x:Name="CodecSummaryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="CodecHint" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="CodecList" Spacing="2" />
                </StackPanel>
            </Expander>

            <!-- ============================== About ============================== -->
            <TextBlock Text="About" Style="{StaticResource SettingsGroupHeaderStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AboutIcon" Width="48" Height="48" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="MikeShift" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AboutHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="UpdatesButton" Content="Check for updates" Click="OnCheckUpdatesClicked" />
                            <Button x:Name="GitHubButton" Content="View on GitHub" Click="OnGitHubClicked" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <local:SettingsCard Header="Open the log folder" Description="Start-up messages and errors, never file contents." HeaderIcon="&#xE838;">
                <Button Content="Open" Click="OnOpenLogsClicked" AutomationProperties.Name="Open the log folder" />
            </local:SettingsCard>

            <local:SettingsCard Header="Licence and credits" Description="MikeShift is open source (MIT)."
                                HeaderIcon="&#xE8D7;">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton Content="Licences" Click="OnNoticeClicked" AutomationProperties.Name="Licences and notices" />
                </StackPanel>
            </local:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Window>
