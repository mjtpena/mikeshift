<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool, NOT part of the shipped package: renders every MikeShift icon from assets/brand/mikeshift.svg
    (MSIX logos, tray .ico files, app .ico, docs/screenshots/brand/icon-sheet.png). Run scripts/make-icons.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IconGen</AssemblyName>
    <RootNamespace>IconGen</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

</Project>
