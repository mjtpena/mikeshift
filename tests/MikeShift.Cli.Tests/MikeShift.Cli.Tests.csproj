<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MikeShift.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI exe (MikeShift.Cli.exe) is copied next to the test assembly by this reference and launched as a child process. -->
    <ProjectReference Include="..\..\src\MikeShift.Cli\MikeShift.Cli.csproj" />
    <!-- Shared test infrastructure (TempDir, OriginalsGuard, Fixtures) lives in Core.Tests. -->
    <ProjectReference Include="..\MikeShift.Core.Tests\MikeShift.Core.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="MikeShift.Core.Tests.Infrastructure" />
  </ItemGroup>

</Project>
